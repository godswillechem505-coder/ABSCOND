PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# SQLite is the local zero-setup default.
DB_DIALECT=sqlite
DB_STORAGE=./abscons.sqlite
DB_SYNC=true
DB_SYNC_ALTER=false
DB_LOGGING=false

# MySQL target config for deployed environments.
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=abscons_one
# DB_USER=abscons_user
# DB_PASSWORD=change-me

JWT_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
